rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 방(초대 링크) 정보: 방장, 승인된 사람, 거절된 사람, 바로 참여 허용 여부
    function room(r) { return get(/databases/$(database)/documents/rooms/$(r)).data; }
    function joined(r) {
      return request.auth.uid == room(r).owner
        || request.auth.uid in room(r).approved
        || (room(r).open == true && !(request.auth.uid in room(r).blocked));
    }
    match /rooms/{r} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.approved == [request.auth.uid]
        && request.resource.data.keys().hasOnly(['owner','approved','blocked','open','at']);
      allow update: if request.auth != null && resource.data.owner == request.auth.uid
        && request.resource.data.owner == resource.data.owner
        && request.resource.data.keys().hasOnly(['owner','approved','blocked','open','at']);
    }
    // 들어온 사람 목록(이름만): 방장이 참여 요청을 보는 데 써요
    match /rooms/{r}/members/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name','who','at']);
    }
    // 각자의 계획: 본인은 항상, 다른 사람은 '승인된 참여자'이면서 공개 범위 안에 있을 때만
    match /rooms/{r}/boards/{uid} {
      allow read: if request.auth != null && (
        request.auth.uid == uid
        || (joined(r) && (resource.data.vis == 'all' || request.auth.uid in resource.data.viewers)));
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name','theme','font','fsz','who','years','updatedAt','vis','viewers'])
        && request.resource.data.vis in ['all','some','none']
        && request.resource.data.viewers is list
        && request.resource.data.viewers.size() <= 50
        && (request.resource.data.vis == 'some' || request.resource.data.viewers.size() == 0);
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
    // 비전보드 사진: 계획과 같은 조건
    match /rooms/{r}/vision/{uid}/years/{year} {
      allow read: if request.auth != null && (
        request.auth.uid == uid
        || (joined(r) && (
          get(/databases/$(database)/documents/rooms/$(r)/boards/$(uid)).data.vis == 'all'
          || request.auth.uid in get(/databases/$(database)/documents/rooms/$(r)/boards/$(uid)).data.viewers)));
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['imgs','updatedAt'])
        && request.resource.data.imgs is list && request.resource.data.imgs.size() <= 8;
    }
  }
}
